# ============================
# MJ Advanced Bashrc (ASCII + Colors + Time)
# ============================

# রঙের শর্টকাট (সহজে ব্যবহার করার জন্য)
RED="\e[1;31m"
GREEN="\e[1;32m"
YELLOW="\e[1;33m"
BLUE="\e[1;34m"
MAGENTA="\e[1;35m"
CYAN="\e[1;36m"
WHITE="\e[1;37m"
RESET="\e[0m"

# ============================
# ASCII Banner (Dragon Power)
# ============================
echo -e "${GREEN}======================================"
echo -e " ${WHITE}MJ Ahmad${RESET} ${RED}${RESET} ${CYAN}Kali Nethunter Environment 🐉${RESET}"
echo -e " ${MAGENTA}Dhaka:${RESET} $(TZ=Asia/Dhaka date '+%Y-%m-%d %H:%M:%S')"
echo -e " ${MAGENTA}UTC:${RESET} $(date -u '+%Y-%m-%d %H:%M:%S')"
echo -e "${GREEN}======================================${RESET}"

# ============================
# রঙিন ডাইনামিক প্রম্পট
# ============================
export PS1="${GREEN}┌──(${CYAN}mj${RESET}㉿${RED}kali${RESET})-[${BLUE}\w${RESET}]\n${GREEN}└─${YELLOW}\$${RESET} "

# ============================
# সাধারণ অ্যালিয়াস
# ============================
alias cls='clear'
alias ll='ls -la'
alias ..='cd ..'

# VM/ক্লাউড কানেকশন
alias connect_vm='ssh myvm'
alias connect_cloud='ssh clouduser@cloud-ip'

# Git শর্টকাট
alias gs='git status'
alias ga='git add .'
alias gc='git commit -m'
alias gp='git push'

# Python/Node শর্টকাট
alias py='python3'
alias npmi='npm install'
alias npms='npm start'

# tmux শর্টকাট
alias tnew='tmux new -s'
alias tls='tmux ls'
alias ta='tmux attach -t'

# sh
alias rn='./run.sh'

# ============================
# প্রজেক্ট জাম্প অ্যালিয়াস
# ============================
alias mj='cd ~/mj'
alias rg='cd ~/mj-registry'
alias dev='cd ~/mjdev'
alias qf='cd ~/qf'
alias pv1='cd ~/mjpv1'

# ============================
# কাস্টম ফাংশন (goto)
# ============================
function goto() {
    case $1 in
        mj) cd ~/mj ;;
        rg) cd ~/mj-registry ;;
        dev) cd ~/mjdev ;;
        qf) cd ~/qf ;;
        pv1) cd ~/mjpv1 ;;
        *) echo -e "${RED}Unknown project:${RESET} $1" ;;
    esac
}

# ============================
# Color Test Function
# ============================
function colortest() {
    echo -e "${RED}RED${RESET} ${GREEN}GREEN${RESET} ${YELLOW}YELLOW${RESET} ${BLUE}BLUE${RESET} ${MAGENTA}MAGENTA${RESET} ${CYAN}CYAN${RESET} ${WHITE}WHITE${RESET}"
}
