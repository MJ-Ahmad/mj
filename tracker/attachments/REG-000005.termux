# ==========================================================
# MJ AHMAD TERMUX ENVIRONMENT
# Version : 1.0
# ==========================================================

# ----------------------------------------------------------
# COLORS
# ----------------------------------------------------------

RED='$$\033[1;31m$$'
GREEN='$$\033[1;32m$$'
YELLOW='$$\033[1;33m$$'
BLUE='$$\033[1;34m$$'
CYAN='$$\033[1;36m$$'
WHITE='$$\033[1;37m$$'
RESET='$$\033[0m$$'

# ----------------------------------------------------------
# ENVIRONMENT
# ----------------------------------------------------------

export TZ=Asia/Dhaka
export EDITOR=nano
export VISUAL=nano
export PAGER=less

export LANG=en_US.UTF-8

# ----------------------------------------------------------
# HISTORY
# ----------------------------------------------------------

HISTSIZE=10000
HISTFILESIZE=20000
HISTCONTROL=ignoredups:erasedups

shopt -s histappend

# ----------------------------------------------------------
# PATH
# ----------------------------------------------------------

export PATH="$HOME/bin:$HOME/.local/bin:$PREFIX/bin:$PATH"

# ----------------------------------------------------------
# PROMPT
# ----------------------------------------------------------

PS1='mj@localhost:\w\$ '

# ----------------------------------------------------------
# NAVIGATION
# ----------------------------------------------------------

alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

alias home='cd ~'

# ----------------------------------------------------------
# FILE MANAGEMENT
# ----------------------------------------------------------

alias ls='ls --color=auto'
alias ll='ls -lah'
alias la='ls -A'
alias l='ls -CF'
alias ub='proot-distro login ubuntu'
alias db='proot-distro login debian'

# ----------------------------------------------------------
# SAFETY
# ----------------------------------------------------------

alias rm='rm -i'
alias cp='cp -i'
alias mv='mv -i'

# ----------------------------------------------------------
# TERMUX
# ----------------------------------------------------------

alias update='pkg update && pkg upgrade -y'
alias install='pkg install'
alias search='pkg search'
alias clean='pkg autoclean'

# ----------------------------------------------------------
# PYTHON
# ----------------------------------------------------------

alias py='python'
alias pipup='pip install --upgrade pip'

# ----------------------------------------------------------
# GIT
# ----------------------------------------------------------

alias gs='git status'
alias ga='git add .'
alias gc='git commit -m'
alias gp='git push'
alias gl='git log --oneline --graph'

# ----------------------------------------------------------
# NETWORK
# ----------------------------------------------------------

alias myip='curl ifconfig.me'

# ----------------------------------------------------------
# UTILITIES
# ----------------------------------------------------------

alias reload='source ~/.bashrc'
alias cls='clear'

aliases() {
    alias | sort
}

sysinfo() {
    echo ""
    echo "User        : $(whoami)"
    echo "Hostname    : $(hostname)"
    echo "Android     : $(getprop ro.build.version.release)"
    echo "Kernel      : $(uname -r)"
    echo "Architecture: $(uname -m)"
    echo ""
}

# ----------------------------------------------------------
# WORKSPACE
# ----------------------------------------------------------

mkdir -p ~/workspace
mkdir -p ~/projects

alias ws='cd ~/workspace'
alias projects='cd ~/projects'

# ----------------------------------------------------------
# WELCOME SCREEN
# ----------------------------------------------------------

welcome() {

local CYAN="\033[1;36m"
local GREEN="\033[1;32m"
local YELLOW="\033[1;33m"
local WHITE="\033[1;37m"
local NC="\033[0m"

DHAKA=$(TZ=Asia/Dhaka date "+%d %b %Y | %I:%M:%S %p")
UTCNOW=$(TZ=UTC date "+%d %b %Y | %H:%M:%S UTC")

clear

echo -e "${CYAN}"
echo "┌─────────────────────────────────────┐"
echo "│     MJ AHMAD TERMUX ENVIRONMENT     │"
echo "└─────────────────────────────────────┘"
echo -e "${NC}"

echo -e "${WHITE}Welcome, ${GREEN}$(whoami)${NC}"
echo ""

echo -e "${YELLOW}Dhaka Time${NC} : ${GREEN}$DHAKA${NC}"
echo -e "${YELLOW}UTC Time  ${NC} : ${GREEN}$UTCNOW${NC}"

echo ""

}

welcome
