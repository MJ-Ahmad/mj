# ============================
# Debian Custom Profile (MJ)
# ============================

# রঙিন ডাইনামিক প্রম্পট
# হোমে থাকলে দেখাবে: MJ :: ~
# অন্য ডিরেক্টরিতে গেলে দেখাবে: MJ :: ~/folder/subfolder
export PS1="\[\e[1;32m\]MJ :: \[\e[1;34m\]\w\[\e[0m\]\n\[\e[1;33m\]\$\[\e[0m\] "

# সাধারণ অ্যালিয়াস
alias cls='clear'
alias ll='ls -la'
alias ..='cd ..'

# VM/ক্লাউড কানেকশন
alias connect_vm='ssh myvm'
alias connect_cloud='ssh clouduser@cloud-ip'

# Git শর্টকাট
alias gs='git status'
alias ga='git add .'
alias gc='git commit -m'
alias gp='git push'

# Python/Node শর্টকাট
alias py='python3'
alias npmi='npm install'
alias npms='npm start'

# tmux শর্টকাট
alias tnew='tmux new -s'
alias tls='tmux ls'
alias ta='tmux attach -t'

# sh
alias rn='./run.sh'

# প্রজেক্ট জাম্প অ্যালিয়াস
alias mj='cd ~/mj'
alias rg='cd ~/mj-registry'
alias dev='cd ~/mjdev'
alias qf='cd ~/qf'
alias pv1='cd ~/mjpv1'

# কাস্টম ফাংশন (goto)
function goto() {
    case $1 in
        mj) cd ~/mj ;;
        rg) cd ~/mj-registry ;;
        dev) cd ~/mjdev ;;
        qf) cd ~/qf ;;
        pv1) cd ~/mjpv1 ;;
        *) echo "Unknown project: $1" ;;
    esac
}

# Welcome Banner
echo -e "\e[1;32m======================================"
echo "┌─────────────────────────────────────┐"
    echo "│     MJ AHMAD DEBIAN ENVIRONMENT 🌀  │"
    echo "└─────────────────────────────────────┘"

echo -e "${YELLOW}UTC Time  :${RESET} $(TZ=UTC date '+%d %b %Y | %H:%M:%S UTC')"
    echo -e "${GREEN}Dhaka Time:${RESET} $(TZ=Asia/Dhaka date '+%d %b %Y | %I:%M:%S %p')"
echo -e "======================================\e[0m"
