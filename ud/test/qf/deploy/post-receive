#!/bin/sh
# Deploys the pushed branch to the web root.
# Install on the server as: <bare-repo>.git/hooks/post-receive (chmod +x).
# Override the defaults with environment variables if needed.
set -e
BRANCH="${QF_BRANCH:-main}"
WEB_DIR="${QF_WEB_DIR:-/var/www/html/qf}"

while read -r oldrev newrev ref; do
  [ "$ref" = "refs/heads/$BRANCH" ] || continue

  TMP="$(mktemp -d)"
  git archive "$newrev" | tar -x -C "$TMP"
  rm -rf "$TMP/scripts" "$TMP/.githooks" "$TMP/deploy" "$TMP/README.md"
  find "$TMP" \( -name "*.md" -o -name ".gitignore" \) -type f -delete

  rm -rf "$WEB_DIR.new" "$WEB_DIR.old"
  mkdir -p "$WEB_DIR.new"
  cp -a "$TMP/." "$WEB_DIR.new/"
  [ -d "$WEB_DIR" ] && mv "$WEB_DIR" "$WEB_DIR.old"
  mv "$WEB_DIR.new" "$WEB_DIR"
  rm -rf "$WEB_DIR.old" "$TMP"

  echo "Deployed $newrev to $WEB_DIR"
done
